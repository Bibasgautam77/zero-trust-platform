# ============================================================
# Enterprise Zero-Trust Access Platform - Environment Config
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ---------- General ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=UTC

# ---------- Postgres ----------
POSTGRES_USER=ztp_user
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=ztp_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ztp_user:changeme_dev_only@postgres:5432/ztp_db

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- OPA (Policy Engine) ----------
OPA_URL=http://opa:8181
OPA_PORT=8181

# ---------- Keycloak (demo OIDC provider) ----------
# A working Keycloak instance ships in docker-compose for local demo/testing.
# For production, point these at your real enterprise IdP instead.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
OIDC_ISSUER=http://localhost:8080/realms/zero-trust
OIDC_CLIENT_ID=ztp-backend
OIDC_CLIENT_SECRET=changeme_generate_a_real_secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ---------- JWT / Session ----------
# Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=changeme_replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=86400
CONTINUOUS_VERIFICATION_INTERVAL_SECONDS=120

# ---------- MFA ----------
MFA_ISSUER_NAME=ZeroTrustPlatform
MFA_TOTP_WINDOW=1

# ---------- Risk Engine thresholds (0-100) ----------
RISK_THRESHOLD_ALLOW=30
RISK_THRESHOLD_STEP_UP=60
RISK_THRESHOLD_DENY=85

# ---------- Optional real-world integrations (NOT active unless set) ----------
# Leave blank to keep these integrations disabled. The app will clearly mark
# device-posture / EDR data as "synthetic/self-reported" until these are set.
EDR_PROVIDER=
EDR_API_KEY=
EDR_API_BASE_URL=
MDM_PROVIDER=
MDM_API_KEY=

# ---------- Backend ----------
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------- Frontend ----------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
